/* Basic stylesheet for the Zola starter site. */
:root {
  --bg: #ffffff;
  --fg: #1f2328;
  --muted: #57606a;
  --accent: #0a66c2;
  --border: #d8dee4;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial,
    sans-serif;
  line-height: 1.6;
  color: var(--fg);
  background: var(--bg);
}

.site-header {
  border-bottom: 1px solid var(--border);
}

.site-nav {
  max-width: 720px;
  margin: 0 auto;
  padding: 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  font-weight: 700;
  text-decoration: none;
  color: var(--fg);
}

.nav-links a {
  margin-left: 1rem;
  text-decoration: none;
  color: var(--accent);
}

.site-main {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.site-footer {
  max-width: 720px;
  margin: 0 auto;
  padding: 1rem;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.9rem;
}

h1,
h2,
h3 {
  line-height: 1.25;
}

a {
  color: var(--accent);
}

.page-date {
  color: var(--muted);
  font-size: 0.9rem;
}

blockquote {
  margin: 1rem 0;
  padding: 0 1rem;
  border-left: 3px solid var(--border);
  color: var(--muted);
}

code {
  background: #f6f8fa;
  padding: 0.15em 0.4em;
  border-radius: 4px;
  font-size: 0.9em;
}